{
  "name": "agendatracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "tsc service-worker.ts --outDir public --lib webworker --skipLibCheck",
    "build": "tsc && vite build",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mantine/core": "^9.4.2",
    "@mantine/dates": "^9.4.2",
    "@mantine/hooks": "^9.4.2",
    "@mui/joy": "^5.0.0-beta.52",
    "@mui/material": "^9.2.0",
    "@mui/x-data-grid": "^9.10.1",
    "@mui/x-data-grid-generator": "^9.10.1",
    "@mui/x-data-grid-premium": "^9.10.1",
    "@mui/x-data-grid-pro": "^9.10.1",
    "@mui/x-date-pickers": "^9.10.1",
    "@tabler/icons-react": "^3.45.0",
    "date-fns": "^2.30.0",
    "dayjs": "^1.11.18",
    "luxon": "^3.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-responsive": "^9.0.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react-swc": "^4.3.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.3.4",
    "jsdom": "^29.1.1",
    "rollup-plugin-copy": "^2.0.1",
    "typescript": "^5.0.2",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
