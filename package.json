{
  "name": "agendatracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "tsc service-worker.ts --outDir public --lib webworker --skipLibCheck",
    "build": "tsc && vite build",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mantine/core": "^6.0.13",
    "@mantine/dates": "^6.0.13",
    "@mui/joy": "^5.0.0-alpha.84",
    "@mui/material": "^5.13.5",
    "@mui/x-data-grid": "^6.7.0",
    "@mui/x-data-grid-generator": "^6.7.0",
    "@mui/x-data-grid-premium": "^6.7.0",
    "@mui/x-data-grid-pro": "^6.7.0",
    "@mui/x-date-pickers": "^6.7.0",
    "@tabler/icons-react": "^2.22.0",
    "date-fns": "^2.30.0",
    "luxon": "^3.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-responsive": "^9.0.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.0.37",
    "@types/react-dom": "^18.0.11",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "@vitejs/plugin-react-swc": "^4.3.2",
    "eslint": "^8.38.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.3.4",
    "jsdom": "^29.1.1",
    "rollup-plugin-copy": "^3.4.0",
    "typescript": "^5.0.2",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
